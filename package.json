{
  "name": "thunder-strike",
  "version": "1.0.0",
  "private": true,
  "description": "雷霆打击 · 纯静态太空弹幕小游戏",
  "scripts": {
    "start": "node tools/serve.js",
    "check": "node tools/check.js",
    "test": "node tools/check.js && node tools/test-worker.js && node tools/smoke-desktop.js && node tools/smoke-mobile.js",
    "test:desktop": "node tools/smoke-desktop.js",
    "test:mobile": "node tools/smoke-mobile.js",
    "test:worker": "node tools/test-worker.js",
    "package:web": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/package.ps1",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/make-icons.ps1"
  }
}
